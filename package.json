{
  "name": "picklist-api",
  "version": "1.0.0",
  "description": "REST API for warehouse product data and asynchronous picking, built with Clean Architecture (PostgreSQL persistence, RabbitMQ async picks, full observability stack).",
  "main": "dist/shared/infra/server.js",
  "scripts": {
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage --testPathPatterns=\"(unit|integration)\\.spec\\.ts$\"",
    "test:watch": "jest --watch --testPathPatterns=\"(unit|integration)\\.spec\\.ts$\"",
    "test:unit": "jest --testPathPatterns=unit.spec.ts",
    "test:integration": "jest --testPathPatterns=integration.spec.ts",
    "test:e2e": "jest --testPathPatterns=e2e.spec.ts --coverage=false",
    "test:messaging": "jest --testPathPatterns=\"picks\\.messaging\\.spec\\.ts$\" --coverage=false",
    "dev": "NODE_ENV=development ts-node-dev -r tsconfig-paths/register --inspect --transpile-only --ignore-watch node_modules --respawn src/shared/infra/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json && mkdir -p dist/shared/infra/database/pg/migrations && cp src/shared/infra/database/pg/migrations/*.sql dist/shared/infra/database/pg/migrations/",
    "start": "node dist/shared/infra/server.js",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "setup": "npm install && npm run build",
    "docs:diagrams": "./scripts/generate-diagrams.sh && ./scripts/generate-system-overview.sh",
    "benchmark": "ts-node -r tsconfig-paths/register scripts/benchmark-repositories.ts",
    "ci": "npm run eslint && npm run format:check && npm run test && npm run build"
  },
  "author": "Luiz Curti",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "qs": ">=6.16.0"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "amqplib": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^6.0.1",
    "pg": "^8.23.0",
    "prom-client": "15.1.3",
    "redis": "^6.2.1",
    "swagger-ui-express": "^5.0.1",
    "yup": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
