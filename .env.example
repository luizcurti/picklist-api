# Server Configuration
PORT=3005

# Environment: development | production | test
NODE_ENV=development

# CORS allowed origin ('*' allows any origin)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# OpenTelemetry tracing (read directly by the OTel SDK; Jaeger's OTLP HTTP
# endpoint when running `docker compose --profile observability up`)
OTEL_SERVICE_NAME=picklist-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RabbitMQ (used by the async pick flow — `docker compose --profile messaging up`)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
PICK_RETRY_MAX=3
PICK_RETRY_DELAY_MS=5000
PICK_RETRY_MAX_DELAY_MS=60000
IDEMPOTENCY_TTL_MS=86400000

# Optional — unset falls back to InMemoryIdempotencyStore (process-local,
# single replica). Set to opt into RedisIdempotencyStore, which recognizes
# a repeated Idempotency-Key across api replicas (same `messaging` profile
# as RabbitMQ).
# REDIS_URL=redis://localhost:6379

# PostgreSQL is the only persistence adapter — `docker compose up -d postgres`.
# Defaults to the docker-compose service's own credentials, so this only
# needs overriding for a different/managed database.
# DATABASE_URL=postgres://picklist:picklist@localhost:5432/picklist

# Comma-separated API keys required (as an X-API-Key header) for every
# /api/v1/* request. Left unset here on purpose: if left unset outside
# production, the app falls back to a well-known 'dev-local-key' so
# `npm run dev`/tests/docs work with zero setup — but the app refuses to
# start at all with NODE_ENV=production and no API_KEYS set.
# API_KEYS=change-me-in-real-deployments
